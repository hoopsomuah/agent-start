{
  "// CopilotVSCode Default Settings": "Optimized for beginners and simplicity",

  "// Editor Settings": "Clean, readable code editing",
  "editor.fontSize": 14,
  "editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', 'Fira Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.guides.indentation": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,

  "// Workbench Settings": "Simplified, clean interface",
  "workbench.startupEditor": "welcomePage",
  "workbench.tips.enabled": false,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vs-seti",
  "workbench.activityBar.location": "top",
  "workbench.editor.showTabs": "single",
  "workbench.statusBar.visible": true,
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.layoutControl.enabled": false,

  "// Window Settings": "Clean window appearance",
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "compact",
  "window.commandCenter": true,

  "// File Settings": "Auto-save for peace of mind",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  "// Explorer Settings": "Simple file navigation",
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": true,
  "explorer.sortOrder": "default",

  "// Terminal Settings": "Integrated terminal",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorBlinking": true,

  "// Git Settings": "Simple version control",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,

  "// Copilot Settings": "AI assistance enabled",
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "yaml": true
  },
  "github.copilot.editor.enableAutoCompletions": true,

  "// Telemetry": "Respect privacy",
  "telemetry.telemetryLevel": "off",

  "// Breadcrumbs": "Navigation aid",
  "breadcrumbs.enabled": true,

  "// Problems Panel": "Show issues clearly",
  "problems.decorations.enabled": true,

  "// Search Settings": "Find things easily",
  "search.showLineNumbers": true,
  "search.smartCase": true,

  "// Extensions": "Pre-configured recommendations",
  "extensions.autoUpdate": true,
  "extensions.ignoreRecommendations": false
}
